# OpenLens local environment — copy to `.env` and fill in what you use.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   uv run uvicorn openlens.main:app --reload
#
# Only enabled backends are instantiated, so most of these can stay empty.
# Never commit a real `.env` (it is git-ignored). See README.md
# "Environment variables" for the full table with defaults and consumers.

# --- Config file override (optional) ---
# OPENLENS_CONFIG=configs/default.yaml

# --- Model backends (configs/models.yaml) ---
MODEL_API_KEY=
# MODEL_BASE_URL=https://api.meta.ai/v1
# MODEL_NAME=muse-spark-1.3
# ANTHROPIC_API_KEY=
# MUSE_API_KEY=
# LOCAL_MODEL_ENDPOINT=http://localhost:11434

# --- Storage backends (storage.* in configs/default.yaml) ---
# OPENLENS_MYSQL_HOST=localhost
# OPENLENS_MYSQL_PORT=3306
# OPENLENS_MYSQL_DATABASE=openlens
# OPENLENS_MYSQL_USER=root
# OPENLENS_MYSQL_PASSWORD=
# OPENLENS_PG_HOST=localhost
# OPENLENS_PG_PORT=5432
# OPENLENS_PG_DBNAME=openlens
# OPENLENS_PG_USER=postgres
# OPENLENS_PG_PASSWORD=

# --- Cache backend (cache.* in configs/default.yaml) ---
# OPENLENS_REDIS_URL=redis://localhost:6379/0

# --- Shared-queue crawler coordination (frontier.* in configs/default.yaml) ---
# Worker identity for atomic claim/lease ownership (defaults to hostname-pid-id).
# OPENLENS_WORKER_ID=worker-1
# Lease TTL must exceed the slowest fetch (timeout_s + max crawl-delay).
# OPENLENS_LEASE_TTL_S=120
# OPENLENS_HEARTBEAT_INTERVAL_S=40
# OPENLENS_REAPER_INTERVAL_S=30
# Persistent-frontier master switch and checkpoint cadence.
# OPENLENS_FRONTIER_ENABLED=true
# OPENLENS_FRONTIER_CKPT_PAGES=10
# OPENLENS_PG_POOL_SIZE=5
# OPENLENS_PG_CONNECT_TIMEOUT=5
# OPENLENS_PG_CHECKOUT_TIMEOUT=5.0

# --- URL frontier admin gate (kids/parental-control: admin-only crawl control) ---
# When set, POST /api/v1/frontier/pause, POST /api/v1/frontier/resume,
# PUT /api/v1/frontier/settings and POST /api/v1/frontier/workers/heartbeat
# require this token via the X-Admin-Token header (reads, including
# GET /api/v1/frontier/workers and /api/v1/frontier/status, stay open).
# Leave empty for local dev (mutations stay open).
# OPENLENS_FRONTIER_ADMIN_TOKEN=

# --- Distributed-crawl workers (crawler service in deploy/local/) ---
# Identity for this worker's heartbeats (dashboard Workers view); empty
# auto-resolves to {hostname}-{pid}-{rand}, which is unique per Compose
# replica — set it only to pin an identity. Shared-queue crawl id and
# heartbeat period (seconds; TTL/3 for the 120s lease window).
# OPENLENS_WORKER_ID=
# OPENLENS_CRAWL_ID=default
# OPENLENS_HEARTBEAT_INTERVAL_S=40
# Backend API base URL for heartbeats (compose crawler uses http://backend:8000).
# OPENLENS_API_URL=http://localhost:8000

# --- Kafka URL queue (distributed crawling) ---
# When OPENLENS_KAFKA_ENABLED=true, frontier seeds are published to the
# Kafka topic and crawler replicas consume via one consumer group
# (group id below), so each URL goes to exactly one live worker.
# Needs the kafka extra: `uv sync --extra kafka`. PLAINTEXT: local dev only.
# OPENLENS_KAFKA_ENABLED=false
# OPENLENS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# OPENLENS_KAFKA_TOPIC=crawl.urls
# OPENLENS_KAFKA_GROUP_ID=crawlers

# --- Frontend ---
# VITE_OPENLENS_API_URL=http://127.0.0.1:8000
