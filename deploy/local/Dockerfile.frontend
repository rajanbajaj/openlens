# OpenLens frontend: Vite build, served by nginx.
# Empty VITE_OPENLENS_API_URL means same-origin; nginx proxies /api/ to backend.
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_OPENLENS_API_URL=""
ENV VITE_OPENLENS_API_URL=$VITE_OPENLENS_API_URL
RUN npm run build

FROM nginx:alpine

COPY deploy/local/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
