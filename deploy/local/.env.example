# Copy to .env and adjust. All values optional (defaults shown).
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMIN_FRONTEND_PORT=3001
POSTGRES_PORT=5432
PGADMIN_PORT=5050
REDIS_PORT=6379

# Postgres store (also wired into the backend as OPENLENS_PG_* in
# docker-compose.yml — change them together).
POSTGRES_USER=openlens
POSTGRES_PASSWORD=openlens
POSTGRES_DB=openlens
# Server connection budget: (crawler replicas + backend) x ~10 at the
# default pool size. 200 covers 12 crawler replicas + backend.
POSTGRES_MAX_CONNECTIONS=200
# Async streaming read replica for search (host-mapped port for local
# inspection; the backend reaches it as postgres-replica:5432 inside
# the compose network). Empty OPENLENS_PG_REPLICA_HOST disables reads
# from the replica (backend falls back to the primary).
POSTGRES_REPLICA_PORT=5433
OPENLENS_PG_REPLICA_HOST=postgres-replica
OPENLENS_PG_REPLICA_PORT=5432

# pgAdmin browser login (phpMyAdmin-style UI for Postgres).
# NOTE: use a normal domain (.io etc) — pgAdmin rejects special-use
# domains such as .local/.localhost/.test at first boot.
PGADMIN_DEFAULT_EMAIL=admin@openlens.io
PGADMIN_DEFAULT_PASSWORD=openlens
# Bind hosts for LAN access (default: localhost only). Set to 0.0.0.0
# to reach these from the LAN (e.g. http://192.168.1.13:8080), then
# recreate the containers. kafka-ui has no login, the pgAdmin and
# Postgres default passwords are public, and ClickHouse currently has
# no password at all — only expose on a trusted network, and set real
# passwords (PGADMIN_DEFAULT_PASSWORD, POSTGRES_PASSWORD) first.
#KAFKA_UI_HOST=0.0.0.0
#PGADMIN_HOST=0.0.0.0
#POSTGRES_HOST=0.0.0.0
#CLICKHOUSE_HOST=0.0.0.0

# Crawler workers (`crawler` service, `docker compose up --scale crawler=N`).
# Worker ids auto-resolve per replica — set OPENLENS_WORKER_ID only to
# pin one replica's identity. The heartbeat token must match the backend
# gate (see the root `.env.example` entry for
# OPENLENS_FRONTIER_ADMIN_TOKEN). Local dev keeps the token empty and opts
# into open mutations below; never set the opt-in on a networked server.
OPENLENS_CRAWL_ID=default
OPENLENS_WORKER_ID=
OPENLENS_HEARTBEAT_INTERVAL_S=40
OPENLENS_FRONTIER_ADMIN_TOKEN=
OPENLENS_ALLOW_OPEN_ADMIN=true

# Rate limiting (per-IP fixed windows). Empty = built-in defaults (see the
# root `.env.example` rate-limit section); set values to override.
OPENLENS_RATE_LIMIT_ENABLED=
OPENLENS_RATE_LIMIT_SEARCH=
OPENLENS_RATE_LIMIT_SUGGEST=
OPENLENS_RATE_LIMIT_FEEDBACK=
OPENLENS_RATE_LIMIT_ADMIN=
OPENLENS_RATE_LIMIT_WS=

# Model backends (passed through to backend + crawler; same names as the
# root `.env.example` — keep the values in sync).
# AI Mode / agent search needs the Meta API backend ON: set
# MODEL_ENABLED=true AND a valid MODEL_API_KEY, then redeploy.
# Key alone is not enough — the default stays offline-safe on purpose.
MODEL_ENABLED=false
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3-contributor

# Kafka URL queue (distributed crawling). The compose stack enables it
# for the backend seed fan-out and the crawler consume loop; brokers
# are kafka-1..3:19092 internally (service DNS), localhost:9092/9094/9095
# from the host for debugging. PLAINTEXT: local dev only.
OPENLENS_KAFKA_ENABLED=true
OPENLENS_KAFKA_BOOTSTRAP_SERVERS=kafka-1:19092,kafka-2:19092,kafka-3:19092
OPENLENS_KAFKA_TOPIC=crawl.urls
OPENLENS_KAFKA_GROUP_ID=crawlers

# Kafka monitor UI (http://localhost:8080) — topics, consumer-group lag,
# and message browser for the crawl queue.
KAFKA_UI_PORT=8080

# Server-side analytics (API -> analytics.events topic -> analytics-worker
# -> ClickHouse). Separate database on purpose: analytics append volume must
# never contend with search reads or frontier writes. Event names and prop
# keys are a closed allowlist (src/openlens/analytics/events.py); raw query
# text is never stored. Keep secrets out of git — copy to release.env.
OPENLENS_ANALYTICS_ENABLED=true
OPENLENS_ANALYTICS_TOPIC=analytics.events
OPENLENS_ANALYTICS_GROUP_ID=analytics
OPENLENS_ANALYTICS_BATCH_SIZE=100
OPENLENS_ANALYTICS_RETENTION_DAYS=90
OPENLENS_ANALYTICS_BACKEND=clickhouse
# Local sqlite fallback when not on compose (shared file so the API and
# the analytics-worker see the same rows; :memory: stays empty).
OPENLENS_ANALYTICS_SQLITE_PATH=data/openlens-analytics.db
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=openlens_analytics
CLICKHOUSE_USER=openlens
CLICKHOUSE_PASSWORD=openlens
OPENLENS_CLICKHOUSE_HOST=clickhouse
OPENLENS_CLICKHOUSE_PORT=8123
OPENLENS_CLICKHOUSE_DB=openlens_analytics
OPENLENS_CLICKHOUSE_USER=openlens
OPENLENS_CLICKHOUSE_PASSWORD=openlens

# Leave empty for same-origin via the nginx /api/ proxy.
VITE_OPENLENS_API_URL=
# Show diagnostic surfaces (search diagnostics rail, chat agent trace).
# Empty/off hides them; set exactly `true` for local development only.
# Takes effect at image build time (`--build` after changing).
VITE_OPENLENS_DEV_MODE=
