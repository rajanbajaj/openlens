# Copy to .env and adjust. All values optional (defaults shown).
BACKEND_PORT=8000
FRONTEND_PORT=3000
OPENSEARCH_PORT=9200

# External search API key (only needed if the bing provider is enabled).
BING_API_KEY=

# Required by the OpenSearch image on first boot (security demo installer).
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Openlens!2026Local

# Leave empty for same-origin via the nginx /api/ proxy.
VITE_OPENLENS_API_URL=
