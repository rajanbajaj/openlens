# OpenLens backend (lightweight): same FastAPI + uvicorn app, but WITHOUT
# the `[kafka,analytics]` extras. Drivers in this repo are lazy-imported
# (`kafka_queue._load_driver`, `analytics.store._load_clickhouse`), and
# every Kafka/ClickHouse call site degrades cleanly when the driver is
# absent — the analytics producer resolves to None (events skipped, never
# a stall or 500) and the store-backed crawler never touches Kafka.
# Installing the extras here would only buy background threads retrying
# an unreachable broker, so the lightweight stack deliberately omits them.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY configs/ ./configs/

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "openlens.main:app", "--host", "0.0.0.0", "--port", "8000"]
